    {
      "text": "무료다. 댓글에 클로드 남기면, 링크 보내준다",
      "hide_sub": true,
      "clips": [{ "file": "etc/터치바_타자.MOV", "in": 12.0, "crop": [0.0, 0.4, 1.0, 0.3] }],
      "overlays": [
        { "text": "무료 🎁", "style": "hook", "from": 0.0, "to": 1.0 },
